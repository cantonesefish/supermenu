#include <windows.h>

1 24 "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.manifest"
101 ICON "@CMAKE_CURRENT_SOURCE_DIR@/../assets/supermenu.ico"

1 VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "SuperMenu"
            VALUE "FileDescription",  "SuperMenu — liquid glass menu bar"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "SuperMenuBar"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "SuperMenuBar.exe"
            VALUE "ProductName",      "SuperMenu"
            VALUE "ProductVersion",   "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
