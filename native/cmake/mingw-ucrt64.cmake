set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(MSYS2_UCRT64 "C:/msys64/ucrt64" CACHE PATH "MSYS2 UCRT64 prefix")
set(CMAKE_C_COMPILER   "${MSYS2_UCRT64}/bin/gcc.exe")
set(CMAKE_CXX_COMPILER "${MSYS2_UCRT64}/bin/g++.exe")
set(CMAKE_RC_COMPILER  "${MSYS2_UCRT64}/bin/windres.exe")
set(CMAKE_AR           "${MSYS2_UCRT64}/bin/ar.exe")
set(CMAKE_RANLIB       "${MSYS2_UCRT64}/bin/ranlib.exe")
set(CMAKE_STRIP        "${MSYS2_UCRT64}/bin/strip.exe")

set(CMAKE_FIND_ROOT_PATH "${MSYS2_UCRT64}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
