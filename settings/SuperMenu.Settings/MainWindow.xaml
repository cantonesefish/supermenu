                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="ResetButton" Style="{StaticResource Style.SecondaryButton}" Content="恢复默认"
                                            Click="ResetButton_Click" ToolTip="把所有设置恢复为默认值（点击应用后写入）" />
                                    <Button x:Name="OpenConfigButton" Style="{StaticResource Style.SecondaryButton}"
                                            Content="打开配置文件" Margin="8,0,0,0" Click="OpenConfigButton_Click" />
                                    <Button x:Name="RestartBarButton" Style="{StaticResource Style.SecondaryButton}"
                                            Content="重启菜单栏" Margin="8,0,0,0" Click="RestartBarButton_Click"
                                            Visibility="Collapsed" />
                                    <Button x:Name="ApplyButton" Style="{StaticResource Style.PrimaryButton}" Content="应用"
                                            Margin="10,0,0,0" Click="ApplyButton_Click" ToolTip="写入设置并通知菜单栏刷新（Ctrl+S）" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Toast -->
                <Border x:Name="ToastRoot" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="600"
                        Margin="0,0,0,88" CornerRadius="12" Background="{DynamicResource Brush.Toast}"
                        BorderBrush="{DynamicResource Brush.Toast.Border}" BorderThickness="1" Padding="14,9"
                        Opacity="0" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastTranslate" Y="10" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#FF000000" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ToastDot" Width="6" Height="6" Fill="{StaticResource Brush.Success}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="ToastText" Text="" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"
                                   MaxWidth="460" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
