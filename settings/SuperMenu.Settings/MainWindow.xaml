                                                    <ToggleButton Grid.Column="1" Style="{StaticResource Style.ToggleSwitch}"
                                                                  VerticalAlignment="Center" Margin="20,0,0,0"
                                                                  AutomationProperties.Name="24 小时制" IsChecked="{Binding Use24Hour, Mode=TwoWay}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

