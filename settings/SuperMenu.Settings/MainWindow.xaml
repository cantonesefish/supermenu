                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <TextBlock Style="{StaticResource Text.SectionHeader}" Text="运行状态" />
                                        <Border Style="{StaticResource Style.PageCard}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
