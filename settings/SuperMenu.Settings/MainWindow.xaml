                                                </Grid>
                                                <Border Style="{StaticResource Style.RowSeparator}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Text.RowTitle}" Text="电池百分比" />
                                                        <TextBlock Style="{StaticResource Text.RowHint}" Text="在电池图标旁同时显示百分比数字。" />
                                                    </StackPanel>
                                                    <ToggleButton Grid.Column="1" Style="{StaticResource Style.ToggleSwitch}"
                                                                  VerticalAlignment="Center" Margin="20,0,0,0"
                                                                  AutomationProperties.Name="电池百分比" IsChecked="{Binding ShowBatteryPercent, Mode=TwoWay}" />
                                                </Grid>
                                                <Border Style="{StaticResource Style.RowSeparator}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Text.RowTitle}" Text="音量" />
