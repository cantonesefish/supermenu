                                                    <ToggleButton Grid.Column="1" Style="{StaticResource Style.ToggleSwitch}"
                                                                  VerticalAlignment="Center" Margin="20,0,0,0"
                                                                  AutomationProperties.Name="音量" IsChecked="{Binding ShowVolume, Mode=TwoWay}" />
                                                </Grid>
                                                <Border Style="{StaticResource Style.RowSeparator}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Text.RowTitle}" Text="控制中心" />
                                                        <TextBlock Style="{StaticResource Text.RowHint}" Text="打开控制中心面板的快捷入口。" />
                                                    </StackPanel>
                                                    <ToggleButton Grid.Column="1" Style="{StaticResource Style.ToggleSwitch}"
                                                                  VerticalAlignment="Center" Margin="20,0,0,0"
