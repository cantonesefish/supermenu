                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Text.RowTitle}" Text="网络" />
                                                        <TextBlock Style="{StaticResource Text.RowHint}" Text="自动显示有线以太网或 Wi‑Fi 状态。" />
