                                                </Grid>
                                                <Border Style="{StaticResource Style.RowSeparator}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource Text.RowTitle}" Text="右侧图标间距" />
                                                        <TextBlock Style="{StaticResource Text.RowHint}"
                                                                   Text="右侧状态图标与小托盘图标的间距（像素/DIP）。" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                                        <Slider Style="{StaticResource Style.Slider}" Width="170" Minimum="2" Maximum="24"
                                                                TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1"
                                                                AutomationProperties.Name="右侧图标间距" Value="{Binding RightIconSpacing, Mode=TwoWay}" />
                                                        <TextBlock Style="{StaticResource Style.SliderValue}"
                                                                   Text="{Binding RightIconSpacing, StringFormat={}{0:0}}" />
                                                        <TextBlock Style="{StaticResource Text.Unit}" Text="px" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Style="{StaticResource Text.SectionHeader}" Text="系统托盘" />
                                        <Border Style="{StaticResource Style.PageCard}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Text.RowTitle}" Text="托盘图标" />
                                                        <TextBlock Style="{StaticResource Text.RowHint}"
                                                                   Text="选择要直接显示在顶栏的托盘图标；关闭的进入右侧隐藏面板。覆盖 Windows 的任务栏显示设置。" />
                                                        <TextBlock x:Name="TraySummaryText" Style="{StaticResource Text.RowHint}" Margin="0,6,0,0"
                                                                   Text="正在读取 Windows 托盘图标…" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="18,0,0,0">
                                                        <Button x:Name="RefreshTrayButton" Style="{StaticResource Style.SecondaryButton}"
                                                                Content="刷新图标" Click="RefreshTrayButton_Click"
                                                                AutomationProperties.Name="刷新图标"
                                                                ToolTip="重新读取 HKCU\Control Panel\NotifyIconSettings" />
                                                        <Button x:Name="ResetTrayButton" Style="{StaticResource Style.SecondaryButton}"
                                                                Content="恢复系统默认" Margin="8,0,0,0" Click="ResetTrayButton_Click"
                                                                AutomationProperties.Name="恢复系统默认"
                                                                ToolTip="清除两个覆盖列表，全部继承 Windows 的显示设置" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border Style="{StaticResource Style.RowSeparator}" />
                                                <!-- Read-only view of Windows' notification-area records; the toggles
                                                     edit trayShow/trayHide only (the native bar renders the icons). -->
                                                <ScrollViewer MaxHeight="300" Padding="0,0,4,0" Focusable="False"
                                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                              AutomationProperties.Name="托盘图标列表滚动区"
                                                              Style="{StaticResource Style.ScrollViewer}">
                                                    <ItemsControl x:Name="TrayIconList" Focusable="False" Margin="0,0,0,2"
                                                                  AutomationProperties.Name="托盘图标列表">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="2" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource Style.TrayRow}" ToolTip="{Binding ToolTip}"
                                                                        ToolTipService.ShowDuration="20000">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid Width="24" Height="24" VerticalAlignment="Center">
                                                                            <Image Width="24" Height="24" Stretch="Uniform"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                                   Source="{Binding Icon}">
                                                                                <Image.Style>
                                                                                    <Style TargetType="Image">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Image.Style>
                                                                            </Image>
                                                                            <Border CornerRadius="6" Background="{DynamicResource Brush.Accent.Soft}">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock Text="{Binding IconFallbackText}" FontFamily="{DynamicResource Font.Demi}" FontWeight="Medium"
                                                                                           FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                                                            </Border>
                                                                        </Grid>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="9,0,8,0"
                                                                                   VerticalAlignment="Center" FontSize="12"
                                                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <ToggleButton Grid.Column="2" Style="{StaticResource Style.ToggleSwitch}"
                                                                                      VerticalAlignment="Center"
                                                                                      IsChecked="{Binding Shown, Mode=TwoWay}"
                                                                                      AutomationProperties.Name="{Binding Label}"
                                                                                      AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                                      ToolTip="{Binding ToolTip}" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Style="{StaticResource Text.SectionHeader}" Text="时钟" />
