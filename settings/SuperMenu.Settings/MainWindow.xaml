<Window x:Class="SuperMenu.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SuperMenu.Settings.Controls"
        x:Name="ShellWindow"
        Title="SuperMenu 设置"
        Width="1096" Height="752" MinWidth="940" MinHeight="662"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource Font.Body}"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        StateChanged="Window_StateChanged"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- ============================================================ Geometry library ============================================================ -->
        <PathGeometry x:Key="Geo.Apple" Figures="M12.2 7.1 C11.2 5.6 9.5 4.8 7.9 5.5 C5.5 6.6 4.1 9.4 4.5 12.4 C5 16.2 7.5 19.6 10.3 19.7 C11.2 19.7 11.7 19.2 12.5 19.2 C13.3 19.2 13.8 19.7 14.7 19.7 C17.5 19.6 20 16.2 20.5 12.4 C20.9 9.4 19.5 6.6 17.1 5.5 C15.5 4.8 13.8 5.6 12.8 7.1 Z" />
        <PathGeometry x:Key="Geo.AppleLeaf" Figures="M13.9 3.5 C15 2.6 16.4 2.6 17.4 3.4 C16.5 4.5 15.2 4.9 13.8 4.7 Z" />
        <PathGeometry x:Key="Geo.AppleStem" Figures="M12.4 6.9 C12.3 5.5 12.8 4.4 13.8 3.6" />
        <!-- Windows four-pane mark; the live preview swaps it in when LogoStyle = "windows". -->
        <PathGeometry x:Key="Geo.WindowsLogo" Figures="M2.5 2.5 H11 V11 H2.5 Z M13 2.5 H21.5 V11 H13 Z M2.5 13 H11 V21.5 H2.5 Z M13 13 H21.5 V21.5 H13 Z" />

        <PathGeometry x:Key="Geo.Nav.Sun" Figures="M12 3.6 V5.4 M12 18.6 V20.4 M3.6 12 H5.4 M18.6 12 H20.4 M5.9 5.9 L7.2 7.2 M16.8 16.8 L18.1 18.1 M18.1 5.9 L16.8 7.2 M7.2 16.8 L5.9 18.1" />
        <PathGeometry x:Key="Geo.Nav.Drop" Figures="M12 3.2 C12 3.2 5.8 10.9 5.8 14.9 C5.8 18.3 8.6 21 12 21 C15.4 21 18.2 18.3 18.2 14.9 C18.2 10.9 12 3.2 12 3.2 Z" />
        <PathGeometry x:Key="Geo.Nav.Menubar" Figures="M6 4.5 H18 A2.5 2.5 0 0 1 20.5 7 V17 A2.5 2.5 0 0 1 18 19.5 H6 A2.5 2.5 0 0 1 3.5 17 V7 A2.5 2.5 0 0 1 6 4.5 Z M3.5 9.5 H20.5" />
        <PathGeometry x:Key="Geo.Nav.Info" Figures="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 11 V16 M12 7.7 V7.8" />

        <PathGeometry x:Key="Geo.Bar.Wifi" Figures="M3 8.5 C6 5.7 8.8 4.5 12 4.5 C15.2 4.5 18 5.7 21 8.5 M6.2 12.1 C8 10.4 9.8 9.6 12 9.6 C14.2 9.6 16 10.4 17.8 12.1 M9.4 15.6 C10.2 14.9 11 14.5 12 14.5 C13 14.5 13.8 14.9 14.6 15.6" />
        <PathGeometry x:Key="Geo.Bar.VolumeSpeaker" Figures="M4 9.5 H7 L11.5 6 V18 L7 14.5 H4 Z" />
        <PathGeometry x:Key="Geo.Bar.VolumeWaves" Figures="M15 9 C16.5 10.2 16.5 13.8 15 15 M17.8 6.8 C20.5 9.2 20.5 14.8 17.8 17.2" />
        <PathGeometry x:Key="Geo.Bar.Bell" Figures="M12 4 C8.9 4 6.6 6.4 6.6 9.5 V13.4 L5.1 15.8 H18.9 L17.4 13.4 V9.5 C17.4 6.4 15.1 4 12 4 Z M10.2 18.4 C10.6 19.2 11.3 19.6 12 19.6 C12.7 19.6 13.4 19.2 13.8 18.4" />
        <PathGeometry x:Key="Geo.Bar.SearchHandle" Figures="M13.2 13.2 L19.5 19.5" />
        <PathGeometry x:Key="Geo.Bar.BatteryOutline" Figures="M2.5 8.5 H18 A1.5 1.5 0 0 1 19.5 10 V14 A1.5 1.5 0 0 1 18 15.5 H2.5 A1.5 1.5 0 0 1 1 14 V10 A1.5 1.5 0 0 1 2.5 8.5 Z M21 10.5 V13.5" />

        <SolidColorBrush x:Key="PreviewInk" Color="#F2FFFFFF" />
        <SolidColorBrush x:Key="PreviewChip" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="PreviewWallpaper" Color="#FF1B1D26" />

        <Style x:Key="Style.PageCard" TargetType="Border" BasedOn="{StaticResource Style.Card}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Style.PreviewMenuChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PreviewChip}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style x:Key="Style.SliderValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Value}">
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="MinWidth" Value="42" />
        </Style>
        <Style x:Key="Style.TrafficGlyph" TargetType="Path">
            <Setter Property="Stroke" Value="#7A1F1300" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Compact row used by the 系统托盘 icon list: 24x24 icon + label + capsule toggle. -->
        <Style x:Key="Style.TrayRow" TargetType="Border">
            <Setter Property="Background" Value="#0AFFFFFF" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,9,6" />
            <Setter Property="MinHeight" Value="36" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Card.Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- ============================================================ Outer window with hand-painted shadow ============================================================ -->
    <Grid x:Name="OuterRoot" Margin="18">
        <Border x:Name="ShadowHost" CornerRadius="22" Background="#FF0A0B10" Opacity="0.75">
            <Border.Effect>
                <DropShadowEffect x:Name="WindowShadowEffect" BlurRadius="42" ShadowDepth="12" Direction="270" Opacity="0.55" Color="#FF000000" />
            </Border.Effect>
        </Border>

        <Border x:Name="WindowShell" CornerRadius="22" BorderThickness="1" BorderBrush="#2BFFFFFF"
                Background="{DynamicResource Brush.Window.Fallback}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ShellTranslate" X="0" Y="0" />
            </Border.RenderTransform>
            <Grid ClipToBounds="True">
                <Grid.Clip>
                    <RectangleGeometry x:Name="ShellClip" RadiusX="22" RadiusY="22" Rect="0,0,1060,716" />
                </Grid.Clip>

                <!-- Wallpaper backdrop + scrim -->
                <Image x:Name="WindowBackdrop" Stretch="UniformToFill" Opacity="0.95" RenderTransformOrigin="0.5,0.5"
                       IsHitTestVisible="False">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="1.18" ScaleY="1.18" />
                    </Image.RenderTransform>
                    <Image.Effect>
                        <BlurEffect Radius="46" RenderingBias="Performance" />
                    </Image.Effect>
                </Image>
                <Border Background="{StaticResource Brush.Window.Scrim}" IsHitTestVisible="False" />
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.82,0.08" GradientOrigin="0.82,0.08" RadiusX="0.7" RadiusY="0.9">
                            <GradientStop Color="#26FF9A45" Offset="0" />
                            <GradientStop Color="#00FF9A45" Offset="0.55" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ============================================================ Shell layout ============================================================ -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Title bar -->
                    <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
                        <StackPanel x:Name="TrafficLightsPanel" Orientation="Horizontal" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="20,0,0,0">
                            <Button x:Name="CloseButton" Style="{StaticResource Style.TrafficLight}" AutomationProperties.Name="关闭"
                                    Background="{StaticResource Brush.Traffic.Close}" Click="CloseButton_Click"
                                    ToolTip="关闭">
                                <Path Style="{StaticResource Style.TrafficGlyph}" Data="M0 0 L6 6 M6 0 L0 6" />
                            </Button>
                            <Button x:Name="MinimiseButton" Style="{StaticResource Style.TrafficLight}" AutomationProperties.Name="最小化" Margin="8,0,0,0"
                                    Background="{StaticResource Brush.Traffic.Minimise}" Click="MinimiseButton_Click"
                                    ToolTip="最小化">
                                <Path Style="{StaticResource Style.TrafficGlyph}" Data="M0 0 L6 0" />
                            </Button>
                            <Button x:Name="ZoomButton" Style="{StaticResource Style.TrafficLight}" AutomationProperties.Name="最大化或还原" Margin="8,0,0,0"
                                    Background="{StaticResource Brush.Traffic.Zoom}" Click="ZoomButton_Click"
                                    ToolTip="最大化 / 还原">
                                <Path Style="{StaticResource Style.TrafficGlyph}" Data="M0 3 L6 3 M3 0 L3 6" />
                            </Button>
                        </StackPanel>

                        <TextBlock Text="SuperMenu 设置" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Body}" FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    </Grid>

                    <!-- Body: sidebar + content -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="228" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ============================================================ Sidebar ============================================================ -->
                        <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar.Gradient}"
                                BorderBrush="#1AFFFFFF" BorderThickness="0,1,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Margin="19,6,16,4">
                                    <Border Width="30" Height="30" CornerRadius="9">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Assets/appicon.png" />
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#FF000000" />
                                        </Border.Effect>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="SuperMenu" FontFamily="{DynamicResource Font.Semi}" FontWeight="Bold" FontSize="14.5"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="菜单栏设置" FontSize="10.5" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                    <RadioButton x:Name="NavAppearance" Style="{StaticResource Style.NavItem}" GroupName="Navigation"
                                                 Checked="NavItem_Checked" Tag="appearance" AutomationProperties.Name="外观">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="26" Height="26" CornerRadius="7">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFFFC463" Offset="0" />
                                                        <GradientStop Color="#FFFF9634" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Ellipse Width="7" Height="7" Stroke="White" StrokeThickness="1.6" />
                                                    <TextBlock Text="&#xE706;" FontFamily="{DynamicResource Font.Icons}"
                                                               FontSize="16" Foreground="White" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="外观" Margin="11,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="NavGlass" Style="{StaticResource Style.NavItem}" GroupName="Navigation"
                                                 Checked="NavItem_Checked" Tag="glass" AutomationProperties.Name="液态玻璃">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="26" Height="26" CornerRadius="7">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FF72B4FF" Offset="0" />
                                                        <GradientStop Color="#FF3B82F6" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="&#xE7A1;" FontFamily="{DynamicResource Font.Icons}"
                                                           FontSize="15" Foreground="White" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="液态玻璃" Margin="11,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="NavMenubar" Style="{StaticResource Style.NavItem}" GroupName="Navigation"
                                                 Checked="NavItem_Checked" Tag="menubar" AutomationProperties.Name="菜单栏">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="26" Height="26" CornerRadius="7">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FF5EE0C6" Offset="0" />
                                                        <GradientStop Color="#FF22B8A2" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="&#xE7F4;" FontFamily="{DynamicResource Font.Icons}"
                                                           FontSize="15" Foreground="White" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="菜单栏" Margin="11,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <Border Height="1" Background="#16FFFFFF" Margin="20,12,20,12" />

                                    <RadioButton x:Name="NavAbout" Style="{StaticResource Style.NavItem}" GroupName="Navigation"
                                                 Checked="NavItem_Checked" Tag="about" AutomationProperties.Name="关于">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="26" Height="26" CornerRadius="7">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFA3A8B4" Offset="0" />
                                                        <GradientStop Color="#FF7E848F" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="&#xE946;" FontFamily="{DynamicResource Font.Icons}"
                                                           FontSize="15" Foreground="White" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="关于" Margin="11,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Margin="22,0,18,18">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="NativeStatusDot" Width="6" Height="6" Fill="#66FFFFFF"
                                                 VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock x:Name="NativeStatusText" Text="菜单栏未运行" FontSize="10.5"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    </StackPanel>
                                    <TextBlock x:Name="VersionText" Text="版本 1.0.0" FontSize="10.5" Margin="0,5,0,0"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ============================================================ Right content ============================================================ -->
                        <Grid x:Name="ContentPanel" Grid.Column="1" Margin="28,4,26,18" MaxWidth="1160">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Page header -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="PageTitleText" Style="{StaticResource Text.PageTitle}" Text="外观" />
                                    <TextBlock x:Name="PageSubtitleText" Style="{StaticResource Text.PageSubtitle}"
                                               Text="调整菜单栏的高度、文字与整体行为" />
                                </StackPanel>
                                <Border x:Name="DirtyPill" Grid.Column="1" VerticalAlignment="Center"
                                        CornerRadius="20" Background="#1AFFB25E" BorderBrush="#3DFFB25E"
                                        BorderThickness="1" Padding="11,5" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource Brush.Accent}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="有未应用的更改" FontSize="11" Foreground="#FFFFCB8F" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ============================================================ Live menu-bar preview ============================================================ -->
                            <Border x:Name="PreviewCard" Grid.Row="1" Height="188" Margin="0,15,0,14" CornerRadius="18"
                                    BorderBrush="#33FFFFFF" BorderThickness="1"
                                    Background="{DynamicResource PreviewWallpaper}" SizeChanged="PreviewCard_SizeChanged">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="26" ShadowDepth="10" Direction="270" Opacity="0.34" Color="#FF000000" />
                                </Border.Effect>
                                <Grid>
                                    <!-- Gentle vignette so the wallpaper reads as a desktop behind the bar. -->
                                    <Border IsHitTestVisible="False" CornerRadius="18">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.35" />
                                                <GradientStop Color="#4D000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- Glass bar clipped to its height; the bar casts its own soft shadow. -->
                                    <Border x:Name="PreviewBarHost" Height="44" VerticalAlignment="Top" ClipToBounds="True">
                                        <Border.Effect>
                                            <DropShadowEffect x:Name="BarShadowEffect" BlurRadius="18" ShadowDepth="6" Direction="270"
                                                              Opacity="0.35" Color="#FF000000" />
                                        </Border.Effect>
                                        <Grid>
                                            <Rectangle x:Name="BarBackdropRect" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       Width="{Binding ActualWidth, ElementName=PreviewCard}"
                                                       Height="{Binding ActualHeight, ElementName=PreviewCard}"
                                                       Fill="{DynamicResource PreviewWallpaper}" RenderTransformOrigin="0.5,0.5">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform x:Name="BarBackdropScale" ScaleX="1.03" ScaleY="1.03" />
                                                </Rectangle.RenderTransform>
                                                <Rectangle.Effect>
                                                    <BlurEffect x:Name="BarBlurEffect" Radius="6" RenderingBias="Quality" />
                                                </Rectangle.Effect>
                                            </Rectangle>

                                            <Border x:Name="BarTintLayer" Background="#0FFFFFFF" />
                                            <Border x:Name="BarSheen" Opacity="0.4">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#3DFFFFFF" Offset="0" />
                                                        <GradientStop Color="#0FFFFFFF" Offset="0.45" />
                                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <!-- Liquid-glass rim: specular top edge, dispersion fringes, bottom sheen -->
                                            <Border x:Name="BarRimTop" Height="1" VerticalAlignment="Top">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                                        <GradientStop Color="#66FFFFFF" Offset="0.12" />
                                                        <GradientStop Color="#66FFFFFF" Offset="0.88" />
                                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border x:Name="BarRimBottom" Height="1" VerticalAlignment="Bottom">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                                        <GradientStop Color="#4DFFFFFF" Offset="0.10" />
                                                        <GradientStop Color="#4DFFFFFF" Offset="0.90" />
                                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border x:Name="BarDispersionWarm" Height="2" VerticalAlignment="Bottom" Background="#FFFF9634" Opacity="0" />
                                            <Border x:Name="BarDispersionCool" Height="2" VerticalAlignment="Top" Background="#FF4FA8FF" Opacity="0" />

                                            <Rectangle x:Name="MovingLight" Width="190" Height="120" VerticalAlignment="Center"
                                                       IsHitTestVisible="False" Opacity="0.4">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                                        <GradientStop Color="#26FFFFFF" Offset="0.5" />
                                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                                <Rectangle.RenderTransform>
                                                    <TranslateTransform x:Name="MovingLightTransform" X="-260" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>

                                            <!-- Bar content -->
                                            <Grid x:Name="BarContent" Margin="14,0,16,0">
                                                <Grid.Effect>
                                                    <DropShadowEffect x:Name="BarTextShadow" BlurRadius="2.4" ShadowDepth="1" Direction="270" Opacity="0.28" Color="#FF000000" />
                                                </Grid.Effect>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Viewbox x:Name="AppleMark" Width="15" Height="17" Margin="2,0,15,0" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="{StaticResource Geo.Apple}" Fill="{DynamicResource PreviewInk}" />
                                                            <Path Data="{StaticResource Geo.AppleLeaf}" Fill="{DynamicResource PreviewInk}" />
                                                            <Path Data="{StaticResource Geo.AppleStem}" Stroke="{DynamicResource PreviewInk}"
                                                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <!-- Same footprint as AppleMark so switching LogoStyle never shifts the bar layout. -->
                                                    <Viewbox x:Name="WindowsMark" Width="15" Height="17" Margin="2,0,15,0"
                                                             VerticalAlignment="Center" Visibility="Collapsed">
                                                        <Canvas Width="24" Height="24">
                                                            <Path x:Name="WindowsMarkPath" Data="{StaticResource Geo.WindowsLogo}" Fill="{DynamicResource PreviewInk}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock x:Name="PreviewAppName" Text="访达" FontFamily="{DynamicResource Font.Demi}" FontWeight="Medium"
                                                               FontSize="13.5" Foreground="{DynamicResource PreviewInk}"
                                                               VerticalAlignment="Center" Margin="0,0,16,0" />
                                                    <StackPanel x:Name="MenuItemsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Margin="0,0,2,0">
                                                            <Grid>
                                                                <Border x:Name="MenuHover0" Background="{DynamicResource PreviewChip}" CornerRadius="5" Opacity="0" />
                                                                <TextBlock x:Name="MenuText0" Text="文件" FontSize="12.5" Margin="7,2" Foreground="{DynamicResource PreviewInk}" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Margin="0,0,2,0">
                                                            <Grid>
                                                                <Border x:Name="MenuHover1" Background="{DynamicResource PreviewChip}" CornerRadius="5" Opacity="0" />
                                                                <TextBlock x:Name="MenuText1" Text="编辑" FontSize="12.5" Margin="7,2" Foreground="{DynamicResource PreviewInk}" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Margin="0,0,2,0">
                                                            <Grid>
