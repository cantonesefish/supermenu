                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Text.RowTitle}" Text="显示日期" />
                                                        <TextBlock Style="{StaticResource Text.RowHint}" Text="在时间前显示星期与日期。" />
                                                    </StackPanel>
                                                    <ToggleButton Grid.Column="1" Style="{StaticResource Style.ToggleSwitch}"
                                                                  VerticalAlignment="Center" Margin="20,0,0,0"
                                                                  AutomationProperties.Name="显示日期" IsChecked="{Binding ShowDate, Mode=TwoWay}" />
                                                </Grid>
                                                <Border Style="{StaticResource Style.RowSeparator}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Text.RowTitle}" Text="显示秒" />
                                                        <TextBlock Style="{StaticResource Text.RowHint}" Text="时间精确到秒。" />
                                                    </StackPanel>
                                                    <ToggleButton Grid.Column="1" Style="{StaticResource Style.ToggleSwitch}"
                                                                  VerticalAlignment="Center" Margin="20,0,0,0"
                                                                  AutomationProperties.Name="显示秒" IsChecked="{Binding ShowSeconds, Mode=TwoWay}" />
                                                </Grid>
                                                <Border Style="{StaticResource Style.RowSeparator}" />
                                                <Grid>
