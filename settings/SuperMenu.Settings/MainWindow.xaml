                                                </Grid>
                                                <Border Style="{StaticResource Style.RowSeparator}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="菜单栏程序" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                    <TextBlock x:Name="AboutNativePathText" Grid.Column="1" Text="未找到 SuperMenuBar.exe"
                                                               Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ShowDuration="20000" />
                                                </Grid>
                                                <Border Style="{StaticResource Style.RowSeparator}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="配置文件" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                    <TextBlock x:Name="AboutConfigPathText" Grid.Column="1" Text=""
                                                               Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ShowDuration="20000" />
                                                </Grid>
                                                <Border Style="{StaticResource Style.RowSeparator}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="界面字体" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                    <TextBlock x:Name="AboutFontText" Grid.Column="1" Text="HarmonyOS Sans SC"
                                                               Style="{StaticResource Text.Mono}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

