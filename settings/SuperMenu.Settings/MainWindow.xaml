                                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                                        <Border Style="{StaticResource Style.PageCard}" Padding="20,18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="62" Height="62" CornerRadius="16" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="/Assets/appicon.png" />
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.4" Color="#FF000000" />
                                                    </Border.Effect>
                                                </Border>
